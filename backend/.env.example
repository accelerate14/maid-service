# Firebase project used by the frontend Firebase Authentication app.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Configure one server-side credential method:
# - Set GOOGLE_APPLICATION_CREDENTIALS to the path of a service-account JSON file, or
# - Set FIREBASE_SERVICE_ACCOUNT_JSON to the complete service-account JSON string.
# Never put service-account credentials in the frontend or commit them to source control.
